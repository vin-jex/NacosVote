# Neon pooled connection string (use the -pooler host, keep sslmode in the URL)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Redis for IP rate limiting (Upstash rediss:// URL works with ioredis)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: verified sender. Defaults to Resend's shared onboarding address.
RESEND_FROM=NacosVote <onboarding@resend.dev>

# Two admins. Generate hashes with: pnpm tsx scripts/hash-password.ts "password"
ADMIN_1_EMAIL=admin1@example.com
ADMIN_1_PASSWORD_HASH=$2a$10$replace_with_output_of_hash_password_script
ADMIN_2_EMAIL=admin2@example.com
ADMIN_2_PASSWORD_HASH=$2a$10$replace_with_output_of_hash_password_script

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Optional: shared secret so a scheduler can drain the email outbox unattended
# (POST /api/admin/outbox/flush with header  x-cron-key: <this value>).
CRON_SECRET=replace_with_openssl_rand_hex_16

# Optional: pg pool size per serverless instance (default 8).
PG_POOL_MAX=8
